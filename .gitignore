# Biblioteki i zależności
node_modules/
dist/
dist-ssr/
*.local

# Pliki środowiskowe (Zgodnie z punktem 4.2 instrukcji) [cite: 71]
# BLOKUJEMY plik z kluczem API
.env
.env.production
.env.local
.env.*.local

# ZEZWALAMY na plik przykładowy (bez wartości), aby inni wiedzieli co skonfigurować [cite: 74]
!.env.example

# Logi błędów
